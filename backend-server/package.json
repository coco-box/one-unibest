{
  "name": "wechat-miniprogram-backend",
  "type": "module",
  "version": "1.0.0",
  "description": "微信小程序后端服务 - Node.js + Express + TypeScript + ESM",
  "author": "",
  "license": "ISC",
  "keywords": [
    "wechat",
    "miniprogram",
    "nodejs",
    "express",
    "typescript"
  ],
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch -r dotenv/config src/app.ts",
    "format": "prettier --write src/**/*.ts",
    "lint": "eslint src/**/*.ts",
    "start": "node dist/app.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
